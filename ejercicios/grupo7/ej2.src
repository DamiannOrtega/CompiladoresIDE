// Grupo 7 - ej2 (selectivo)
// Dado un entero, imprimir si es positivo=0, negativo=1 o nulo=2.
// Entradas: N (entero)
main {
  int n, r;
  cin >> n;
  if n > 0 then
    r = 0;
  else
    if n < 0 then
      r = 1;
    else
      r = 2;
    end
  end
  cout << "Resultado (positivo=0, negativo=1, nulo=2): " << r;
}
