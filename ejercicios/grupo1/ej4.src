// Grupo 1 - ej4 (repetitivo)
// Calcular el término N de la serie de Fibonacci (los dos primeros son 0 y 1).
// Entradas: N (entero, N >= 1)
main {
  int n, i, a, b, t;
  cin >> n;
  a = 0;
  b = 1;
  i = 1;
  while i < n
    t = a + b;
    a = b;
    b = t;
    i++;
  end
  if n >= 1 then
    cout << "Termino N de Fibonacci: " << a;
  else
    cout << "N debe ser mayor o igual a 1";
  end
}
