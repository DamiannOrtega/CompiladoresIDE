// Grupo 5 - ej1 (secuencial)
// Dados el radio y la altura de un cilindro, calcular Volumen = pi * radio^2 * altura y Área = 2 * pi * radio * altura.
// Entradas: Radio, altura (reales)
main {
  float radio, altura, volumen, area;

  cout << "=== Área y volumen de un cilindro ===";
  cout << "Introduce el radio del cilindro:";
  cin >> radio;
  cout << "Introduce la altura del cilindro:";
  cin >> altura;

  volumen = 3.14159 * radio ^ 2 * altura;
  area = 2 * 3.14159 * radio * altura;

  cout << "--- Resultados ---";
  cout << "Radio: " << radio;
  cout << "Altura: " << altura;
  cout << "El área del cilindro es: " << area;
  cout << "El volumen del cilindro es: " << volumen;
}
