// Grupo 5 - ej4 (repetitivo)
// Dados N números enteros, calcular y mostrar el mayor y el menor.
// Entradas: N y luego los N números enteros
main {
  int n, i, x, mayor, menor;

  cout << "=== Mayor y menor de N números ===";
  cout << "¿Cuántos números vas a introducir?";
  cin >> n;

  i = 1;
  while i <= n
    cout << "Introduce el número " << i;
    cin >> x;
    if i == 1 then
      mayor = x;
      menor = x;
    else
      if x > mayor then
        mayor = x;
      end
      if x < menor then
        menor = x;
      end
    end
    i++;
  end

  cout << "--- Resultados ---";
  if n > 0 then
    cout << "Cantidad de números introducidos: " << n;
    cout << "El número mayor es: " << mayor;
    cout << "El número menor es: " << menor;
  else
    cout << "No se introdujo ningún número, no hay mayor ni menor.";
  end
}
