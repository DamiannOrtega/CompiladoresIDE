// Grupo 2 - ej1 (secuencial)
// Dado el ID y 5 calificaciones de un alumno, imprimir su matrícula y su promedio.
// Entradas: ID (entero), 5 calificaciones (reales)
main {
  int id;
  float c1, c2, c3, c4, c5, promedio;
  cin >> id;
  cin >> c1;
  cin >> c2;
  cin >> c3;
  cin >> c4;
  cin >> c5;
  promedio = (c1 + c2 + c3 + c4 + c5) / 5;
  cout << "Matrícula: " << id;
  cout << "Promedio: " << promedio;
}
